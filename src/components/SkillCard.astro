---
interface Props {
  area: string
  items: string[]
}

const { area, items } = Astro.props
---

<article class="rounded-xl border border-neutral-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
  <h3 class="text-sm font-semibold uppercase tracking-widest text-neutral-500">
    {area}
  </h3>
  <ul class="mt-3 flex flex-wrap gap-2">
    {items.map((skill) => (
      <li class="rounded-full bg-neutral-100 px-3 py-1 text-sm text-neutral-800">
        {skill}
      </li>
    ))}
  </ul>
</article>
