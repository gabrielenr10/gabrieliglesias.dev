---
import { navigation } from '../data/navigation'
---

<header class="sticky top-0 z-50 border-b border-neutral-200 bg-white/90 backdrop-blur">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-4xl items-center justify-center px-4 py-3"
  >
    <ul class="hidden flex-1 items-center justify-center gap-2 md:flex">
      {navigation.map((link) => (
        <li class="w-28 text-center">
          <a
            href={link.href}
            class="inline-block w-full text-center text-sm text-neutral-600 transition-colors hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <details class="relative md:hidden">
      <summary
        aria-label="Toggle menu"
        class="cursor-pointer list-none rounded-md border border-neutral-200 px-3 py-1.5 text-sm [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <ul class="absolute left-1/2 mt-2 w-44 -translate-x-1/2 rounded-lg border border-neutral-200 bg-white p-2 shadow-lg">
        {navigation.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-3 py-2 text-center text-sm text-neutral-700 hover:bg-neutral-100"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
